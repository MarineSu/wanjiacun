---
interface Props {
  mode?: 'login' | 'register';
}
const { mode = 'login' } = Astro.props;
---
<div class="auth-wrap">
  <div class="auth-card">
    <h1>{mode === 'register' ? '注册玩家村' : '登录玩家村'}</h1>
    <p class="muted">
      输入手机号获取验证码。第一次登录会自动创建账号，不需要单独注册。
    </p>

    <form id="auth-form" novalidate>
      <label class="field">
        <span>手机号</span>
        <input type="tel" name="phone" required inputmode="numeric" maxlength="11"
               placeholder="11 位手机号" autocomplete="tel" />
      </label>

      <label class="field">
        <span>验证码</span>
        <div class="code-row">
          <input type="text" name="code" required inputmode="numeric" maxlength="6"
                 placeholder="6 位数字" autocomplete="one-time-code" />
          <button type="button" id="send-code" class="send-btn">获取验证码</button>
        </div>
      </label>

      <button type="submit" class="submit">登录 / 注册</button>
      <p id="auth-msg" class="msg" role="status" aria-live="polite"></p>
    </form>

    <p class="note muted">
      我们不会公开你的手机号，社区里只显示你的 UID 和用户名。
    </p>
  </div>
</div>

<script>
  const form = document.getElementById('auth-form') as HTMLFormElement | null;
  const msg = document.getElementById('auth-msg');
  const sendBtn = document.getElementById('send-code') as HTMLButtonElement | null;
  const phoneInput = form?.querySelector('input[name="phone"]') as HTMLInputElement | null;
  const codeInput = form?.querySelector('input[name="code"]') as HTMLInputElement | null;

  const setMsg = (t: string, ok = false) => {
    if (!msg) return;
    msg.textContent = t;
    msg.classList.toggle('ok', ok);
  };

  // ---- 发送验证码（60 秒倒计时）----
  let timer: number | null = null;
  sendBtn?.addEventListener('click', async () => {
    const phone = (phoneInput?.value || '').replace(/\D/g, '');
    if (!/^1[3-9]\d{9}$/.test(phone)) return setMsg('请输入 11 位中国大陆手机号');

    sendBtn.disabled = true;
    setMsg('正在发送…');
    try {
      const res = await fetch('/api/auth/send-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        setMsg(data.error || '发送失败，请稍后重试');
        sendBtn.disabled = false;
        return;
      }
      // 开发模式（未接短信服务）会回传验证码，自动帮用户填上
      if (data.devCode && codeInput) {
        codeInput.value = data.devCode;
        setMsg('开发模式：验证码已自动填入', true);
      } else {
        setMsg('验证码已发送，请查看短信', true);
      }
      let left = 60;
      if (timer) window.clearInterval(timer);
      sendBtn.textContent = `${left} 秒后重发`;
      timer = window.setInterval(() => {
        left -= 1;
        if (!sendBtn) return;
        if (left <= 0) {
          window.clearInterval(timer as number);
          sendBtn.disabled = false;
          sendBtn.textContent = '重新获取';
        } else {
          sendBtn.textContent = `${left} 秒后重发`;
        }
      }, 1000);
    } catch {
      setMsg('网络异常，请稍后重试');
      sendBtn.disabled = false;
    }
  });

  // ---- 提交验证码 ----
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const phone = (phoneInput?.value || '').replace(/\D/g, '');
    const code = (codeInput?.value || '').replace(/\D/g, '');
    if (!/^1[3-9]\d{9}$/.test(phone)) return setMsg('请输入 11 位中国大陆手机号');
    if (!/^\d{6}$/.test(code)) return setMsg('请输入 6 位数字验证码');

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (btn) btn.disabled = true;
    setMsg('验证中…');

    try {
      const res = await fetch('/api/auth/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, code }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        setMsg(data.isNew ? '注册成功，正在跳转…' : '登录成功，正在跳转…', true);
        location.href = '/';
      } else {
        setMsg(data.error || '验证失败，请重试');
      }
    } catch {
      setMsg('网络异常，请稍后重试');
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>

<style>
  .auth-wrap { display: flex; justify-content: center; padding: 24px 0 48px; }
  .auth-card {
    width: 100%; max-width: 420px; background: var(--surface);
    border: 1px solid var(--border); border-radius: 14px; padding: 30px 28px 24px;
  }
  .auth-card h1 { margin: 0 0 8px; font-size: 24px; }
  .field { display: block; margin: 18px 0 0; }
  .field span { display: block; font-size: 14px; color: var(--muted); margin-bottom: 6px; }
  .field input {
    width: 100%; padding: 11px 13px; font-size: 15px; color: var(--text);
    background: var(--bg); border: 1px solid var(--border); border-radius: 9px;
  }
  .field input:focus { outline: none; border-color: var(--accent); }
  .code-row { display: flex; gap: 10px; }
  .code-row input { flex: 1; min-width: 0; }
  .send-btn {
    flex: none; padding: 0 14px; font-size: 14px; font-family: inherit;
    color: var(--accent); background: transparent;
    border: 1px solid rgba(94, 234, 212, .35); border-radius: 9px; cursor: pointer;
    white-space: nowrap;
  }
  .send-btn:disabled { color: var(--muted); border-color: var(--border); cursor: default; }
  .submit {
    width: 100%; margin-top: 24px; padding: 12px; font-size: 15px; font-weight: 600;
    color: #06231d; background: var(--accent); border: 0; border-radius: 9px; cursor: pointer;
    font-family: inherit;
  }
  .submit:disabled { opacity: .6; cursor: default; }
  .msg { min-height: 22px; margin: 12px 0 0; font-size: 14px; color: #ff8f8f; }
  .msg.ok { color: var(--accent); }
  .note { margin: 18px 0 0; font-size: 13px; line-height: 1.6; }
</style>
