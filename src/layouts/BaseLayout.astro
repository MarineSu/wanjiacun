---
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  path = '/',
  image,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(path, SITE.url).href;
const ogImage = image ? new URL(image, SITE.url).href : undefined;

const nav = [
  { href: '/', label: '首页' },
  { href: '/guides/', label: '攻略库' },
  { href: '/games/', label: '游戏库' },
];
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- 搜索引擎站长平台验证 -->
    <meta name="msvalidate.01" content="D9079A725C4B6410A3BC27EF30C12F6A" />
    <meta name="baidu-site-verification" content="codeva-zSOisSVYJZ" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">{SITE.name}</a>
      <nav>
        {nav.map((n) => (
          <a href={n.href} class={Astro.url.pathname === n.href ? 'on' : ''}>{n.label}</a>
        ))}
      </nav>
      <div class="auth-area" id="auth-area">
        <a href="/login/" class="auth-link">登录</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{SITE.name} · {SITE.tagline}</p>
      <p class="dim">攻略内容仅供学习交流，版权归各游戏厂商所有。</p>
    </footer>

    <style is:global>
      :root {
        --bg: #0b0d12;
        --surface: #14171f;
        --surface-2: #1a1e28;
        --border: #232833;
        --text: #e6e8ee;
        --muted: #9aa3b2;
        --accent: #5eead4;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.75 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      }
      a { color: inherit; text-decoration: none; }
      a:hover { color: var(--accent); }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }

      .site-header {
        display: flex; align-items: center; gap: 28px;
        max-width: 1080px; margin: 0 auto; padding: 18px 20px;
        border-bottom: 1px solid var(--border);
      }
      .brand { font-size: 20px; font-weight: 700; letter-spacing: .5px; }
      .site-header nav { display: flex; gap: 20px; font-size: 15px; color: var(--muted); }
      .site-header nav a.on { color: var(--accent); }
      .auth-area { margin-left: auto; display: flex; align-items: center; gap: 12px; font-size: 14px; }
      .auth-area .who { color: var(--accent); max-width: 140px; overflow: hidden;
        text-overflow: ellipsis; white-space: nowrap; }
      .auth-area .auth-link {
        background: none; border: 1px solid var(--border); color: var(--muted);
        border-radius: 8px; padding: 5px 12px; font-size: 14px; cursor: pointer;
        font-family: inherit;
      }
      .auth-area .auth-link:hover { border-color: var(--accent); color: var(--accent); }

      main { max-width: 1080px; margin: 0 auto; padding: 36px 20px 72px; }
      h1 { font-size: 30px; line-height: 1.35; margin: 0 0 12px; }
      h2 { font-size: 22px; margin: 40px 0 14px; }
      h3 { font-size: 18px; margin: 28px 0 10px; }
      p { margin: 0 0 14px; }
      .muted { color: var(--muted); }
      .dim { color: var(--muted); font-size: 13px; }

      .grid { display: grid; gap: 16px; }
      .grid-2 { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }

      .card {
        display: block; background: var(--surface); border: 1px solid var(--border);
        border-radius: 12px; padding: 18px 20px; transition: border-color .15s, transform .15s;
      }
      .card:hover { border-color: var(--accent); transform: translateY(-2px); color: var(--text); }
      .card h3 { margin: 0 0 8px; font-size: 17px; }
      .card p { margin: 0; color: var(--muted); font-size: 14px; }

      .tag {
        display: inline-block; font-size: 12px; color: var(--accent);
        border: 1px solid rgba(94, 234, 212, .35); border-radius: 99px;
        padding: 2px 10px; margin-right: 6px;
      }
      .crumb { font-size: 14px; color: var(--muted); margin-bottom: 18px; }
      .prose table { width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 15px; }
      .prose th, .prose td { border: 1px solid var(--border); padding: 8px 12px; text-align: left; }
      .prose th { background: var(--surface-2); }
      .prose code { background: var(--surface-2); padding: 2px 6px; border-radius: 5px; font-size: 14px; }
      .prose ul, .prose ol { padding-left: 22px; }
      .site-footer {
        border-top: 1px solid var(--border); padding: 26px 20px 40px;
        max-width: 1080px; margin: 0 auto; color: var(--muted); font-size: 14px;
      }
    </style>

    <script>
      // 头部登录状态：登录后把“登录”换成用户名 + 退出
      (async () => {
        const el = document.getElementById('auth-area');
        if (!el) return;
        try {
          const res = await fetch('/api/auth/me', { headers: { Accept: 'application/json' } });
          if (!res.ok) return;
          const data = await res.json();
          const user = data?.user;
          if (!user) return;

          el.replaceChildren();
          const who = document.createElement('span');
          who.className = 'who';
          who.textContent = user.displayName || user.username
            || (user.uid ? `UID ${user.uid}` : '已登录');

          const btn = document.createElement('button');
          btn.className = 'auth-link';
          btn.textContent = '退出';
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            await fetch('/api/auth/logout', { method: 'POST' }).catch(() => {});
            location.reload();
          });

          el.append(who, btn);
        } catch {
          /* 接口不可用时保持默认的“登录”链接，不影响页面其他部分 */
        }
      })();
    </script>
  </body>
</html>
