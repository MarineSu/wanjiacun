function mvRow(r,h){
  const w=Math.min(100,Math.abs(r.d)*700+10);
  return `<div class="row" data-go="${r.h.id}">
    <img src="/dota2/icons/${r.h.slug}.png" loading="lazy" alt="">
    <span class="nm">${r.h.n}</span>
    <span class="bar"><i style="width:${w}%;background:${r.d>=0?'var(--green)':'var(--red)'}"></i></span>
    <span class="val ${r.d>0.015?'pos':r.d<-0.015?'neg':'neu'}">${pct(r.p)}</span>
    <span class="g">${r.g}场</span></div>`;
}
function fillTable(rows,h){
  let rs=rows.filter(r=>r.g>=minGames);
  if(onlyDiff)rs=rs.filter(r=>Math.abs(r.d)>=0.02);
  const dir=asc?1:-1;
  rs=rs.slice().sort((a,b)=>{
    if(sortKey==='n')return a.h.n.localeCompare(b.h.n,'zh-Hans-CN')*dir;
    return (a[sortKey]-b[sortKey])*dir;
  });
  document.getElementById('cnt').textContent=`（${rs.length} 个，已过滤 ${minGames} 场以下）`;
  document.getElementById('tb').innerHTML=rs.map(r=>`
    <tr><td><span class="opp" data-go="${r.h.id}">
      <img src="/dota2/icons/${r.h.slug}.png" loading="lazy" alt=""><b>${r.h.n}</b></span></td>
    <td class="r" style="color:${r.g<80?'var(--tx3)':'var(--tx2)'}${r.g<80?';opacity:.65':''}">${r.g.toLocaleString()}</td>
    <td class="r ${wrClass(r.p,h.wr)}"><b>${pct(r.p)}</b></td>
    <td class="r ${r.d>0.015?'pos':r.d<-0.015?'neg':'neu'}">${sign(r.d)}</td>
    <td class="r">${bar(r.p,h.wr)}</td></tr>`).join('')||
    '<tr><td colspan="5" class="empty">没有满足条件的对位，试着调低最小场次</td></tr>';
  document.querySelectorAll('#hero-body [data-go]').forEach(el=>el.onclick=()=>{
    curHero=+el.dataset.go;document.querySelector('#pk1 input').value=BYID[curHero].n;
    renderHero();window.scrollTo({top:0,behavior:'smooth'});
  });
}

/* ================= 视图 3：阵容克制推荐 ================= */
let enemies=[null,null,null,null,null];
function initDraft(){
  const box=document.getElementById('slots');
  box.innerHTML=enemies.map((e,i)=>`<div class="slot${e?' filled':''}" id="slot${i}">
    ${e?`<img src="/dota2/icons/${BYID[e].slug}.png"><div style="flex:1;min-width:0"><b style="font-size:13.5px">${BYID[e].n}</b>
      <div style="color:var(--tx3);font-size:11.5px">${BYID[e].en}</div></div><span class="x" data-i="${i}">✕</span>`
     :`<input type="text" placeholder="敌方英雄 ${i+1}" data-i="${i}" autocomplete="off">`}
  </div>`).join('')+`<div class="slot" style="border-style:dashed;justify-content:center;color:var(--tx3);font-size:12px;cursor:pointer" id="clear">清空全部</div>`;
  // 已填槽位点击移除
  box.querySelectorAll('.slot.filled').forEach((el,i)=>{});
  box.querySelectorAll('.x').forEach(x=>x.onclick=()=>{enemies[+x.dataset.i]=null;initDraft();renderDraft();});
  document.getElementById('clear').onclick=()=>{enemies=[null,null,null,null,null];initDraft();renderDraft();};
  // 空槽位挂搜索
  box.querySelectorAll('input[data-i]').forEach(inp=>{
    const i=+inp.dataset.i;
    const wrap=document.createElement('div');wrap.className='drop';
    wrap.style.position='absolute';wrap.style.left='8px';wrap.style.right='8px';wrap.style.top='100%';
    inp.parentElement.appendChild(wrap);
    function match(q){ return searchHeroes(q, enemies.filter(Boolean)); }
    function show(){
      const l=match(inp.value);
      wrap.innerHTML=l.map(h=>`<div class="it" data-id="${h.id}">
        <img src="/dota2/icons/${h.slug}.png"><span class="nm"><b>${h.n}</b><span>${h.en}</span></span></div>`).join('')
        ||'<div class="it"><span class="nm"><b>无匹配</b></span></div>';
      wrap.classList.add('on');
      wrap.querySelectorAll('.it').forEach(el=>el.onmousedown=e=>{
        e.preventDefault();const id=+el.dataset.id;if(!id)return;
        enemies[i]=id;initDraft();renderDraft();
      });
    }
    inp.oninput=show; inp.onfocus=show; inp.onblur=()=>setTimeout(()=>wrap.classList.remove('on'),120);
  });
}
function renderDraft(){
  const E=enemies.filter(Boolean);
  if(!E.length){document.getElementById('draft-body').innerHTML='<div class="empty">填入敌方英雄（最多 5 个），推荐对阵最有利的英雄</div>';return;}
  const res=HEROES.filter(h=>!E.includes(h.id)).map(h=>{
    let sum=0,n=0,det=[];
    for(const j of E){
      const s=shrunk(h.id,j); if(!s||s.g<20)continue;
      const d=s.p-h.wr; sum+=d; n++;
      det.push({id:j,d,g:s.g});
    }
    return {h,score:n?sum/n:-9,n,det};
  }).filter(r=>r.n>0).sort((a,b)=>b.score-a.score);
  const top=res.slice(0,12), bottom=res.slice(-5).reverse();
  document.getElementById('draft-body').innerHTML=`
    <div class="panel"><h3>🛡 推荐英雄 <span class="badge">对当前敌方阵容平均相对优势（按样本量收缩）</span></h3>
      <div>${top.map((r,i)=>resRow(r,i+1)).join('')}</div></div>
    <div class="panel" style="margin-top:16px"><h3>⛔ 最差选择 <span class="badge">对阵该阵容相对吃亏</span></h3>
      <div>${bottom.map((r,i)=>resRow(r,i+1,res.length-bottom.length+1)).join('')}</div></div>
    <div class="note"><b>算法：</b>对每个候选英雄，逐个计算它与敌方每个英雄的对位胜率，减去它自身的整体胜率得到「相对优势」，
    再按样本量做贝叶斯收缩（场次少的对位向基准回归，避免 3 场 100% 胜率的假象），最后取平均排序。<br>
    <b>注意：</b>本工具只看历史对位数据，不考虑位置、阵容搭配、出装与版本改动，仅作选人参考。</div>`;
}
function resRow(r,rank,alt){
  return `<div class="res-row"><span class="rk">${rank}</span>
    <img src="/dota2/icons/${r.h.slug}.png" alt="">
    <span class="nm">${r.h.n}<div style="color:var(--tx3);font-size:11px;font-weight:400">${pct(r.h.wr)} 基准</div></span>
    <span class="det">${r.det.map(d=>`<span class="det-i"><img src="/dota2/icons/${BYID[d.id].slug}.png">
      对${BYID[d.id].n} <b class="${d.d>0?'pos':'neg'}">${sign(d.d,1)}</b></span>`).join('')}</span>
    <span class="score ${r.score>0.015?'pos':r.score<-0.015?'neg':'neu'}">${sign(r.score)}</span></div>`;
}

/* ================= tab 切换 ================= */
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
  document.querySelectorAll('.view').forEach(x=>x.classList.remove('on'));
  t.classList.add('on');
  document.getElementById('v-'+t.dataset.v).classList.add('on');
  track('feature', t.innerText.trim());           // 统计：各板块使用情况
});

boot();

</script>
