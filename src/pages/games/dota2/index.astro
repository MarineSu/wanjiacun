        </div>
      </div>
      <div class="hh-stats">
        <div><b class="${wrClass(h.pub_pick?h.pub_win/h.pub_pick:0.5,0.5)}">${h.pub_pick?pct(h.pub_win/h.pub_pick):'—'}</b><span>普通模式 · 近7天</span></div>
        <div><b class="${wrClass(h.turbo_pick?h.turbo_win/h.turbo_pick:0.5,0.5)}">${h.turbo_pick?pct(h.turbo_win/h.turbo_pick):'—'}</b><span>快速模式 · 近7天</span></div>
        <div><b>${wfmt(h.games)}</b><span>历史对位样本</span></div>
      </div>
    </div>
    <div class="two-col">
      <div class="panel"><h3><span style="color:var(--green)">▲</span> 最克制 <span class="badge">同场胜率最高 · ≥100 场</span></h3>
        <div class="mv">${strong.map(r=>mvRow(r,h)).join('')||'<div class="empty">样本不足</div>'}</div></div>
      <div class="panel"><h3><span style="color:var(--red)">▼</span> 最苦手 <span class="badge">同场胜率最低 · ≥100 场</span></h3>
        <div class="mv">${weak.map(r=>mvRow(r,h)).join('')||'<div class="empty">样本不足</div>'}</div></div>
    </div>
    <div class="panel">
      <div class="tbar">
        <b style="font-size:13.5px">全部对阵</b>
        <span style="color:var(--tx3);font-size:12px" id="cnt"></span>
        <span class="sp"></span>
        <label>最小场次 <input type="range" id="mg" min="0" max="1000" step="25" value="${minGames}"><b id="mgv" style="color:var(--tx);width:40px;display:inline-block">${minGames}</b></label>
        <label><input type="checkbox" id="od" ${onlyDiff?'checked':''}> 只看克制/被克制</label>
        <select id="sk">
          <option value="p"${sortKey==='p'?' selected':''}>对位胜率</option>
          <option value="g"${sortKey==='g'?' selected':''}>样本场次</option>
          <option value="d"${sortKey==='d'?' selected':''}>相对基准</option>
          <option value="n"${sortKey==='n'?' selected':''}>名称</option>
        </select>
      </div>
      <div class="tbl"><table>
        <thead><tr>
          <th data-k="n">对手</th><th class="r" data-k="g">样本场次</th><th class="r" data-k="p">对位胜率</th>
          <th class="r" data-k="d">相对基准</th><th class="r">强弱</th>
        </tr></thead>
        <tbody id="tb"></tbody>
      </table></div>
    </div>
    <div class="note">
      <span class="nb"><b>对位胜率</b>：该英雄与对手同场时该英雄的胜场占比（不分位置、不分段位）。</span>
      <span class="nb"><b>相对基准</b>：对位胜率 − 该英雄整体胜率 ${pct(h.wr)}。正值 = 打这个对手比自己平时更顺。判断克制关系看它比看原始胜率更准——原始胜率会被对手英雄本身的强弱影响。</span>
      <span class="nb"><b>样本</b>：对位数据来自 Stratz 公开对局汇总（共 ${wfmt((DATA.mu_stats||{}).total_games||0)} 场、${(DATA.mu_stats||{}).combos||0} 组英雄组合，单组中位 ${((DATA.mu_stats||{}).median_games||0).toLocaleString()} 场），胜率误差约 ±2 个百分点。下方表格默认过滤 50 场以下（可用滑块调整）。</span>
      <span class="nb"><b>数据范围</b>：对位样本为 Stratz 汇总的历史公开对局（跨版本累计，抓取于 ${DATA.generated_at}），<b>不代表当前版本</b>。要看当前版本的强弱，请用顶部「版本胜率榜」（自动更新的最近 7 天数据）。</span>
    </div>`;
  document.getElementById('mg').oninput=e=>{minGames=+e.target.value;document.getElementById('mgv').textContent=minGames;fillTable(rows,h);};
  document.getElementById('od').onchange=e=>{onlyDiff=e.target.checked;fillTable(rows,h);};
  document.getElementById('sk').onchange=e=>{sortKey=e.target.value;fillTable(rows,h);};
  document.querySelectorAll('#v-hero thead th').forEach(th=>th.onclick=()=>{
    const k=th.dataset.k; if(sortKey===k)asc=!asc; else {sortKey=k;asc=(k==='n');}
    const s=document.getElementById('sk'); if(s)s.value=k; fillTable(rows,h);
  });
  document.querySelectorAll('#v-hero thead th[data-k]').forEach(()=>{});
  fillTable(rows,h);
