      <div class="hh-info">
        <h2>${h.n}</h2>
        <div class="en">${h.en}</div>
        <div class="chips">
          <span class="chip ${attrCls[h.attr]||''}">${attrName[h.attr]||h.attr}</span>
          <span class="chip">${h.atk==='Melee'?'近战':'远程'}</span>
